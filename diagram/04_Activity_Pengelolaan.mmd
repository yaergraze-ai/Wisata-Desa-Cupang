  OPSI -->|"Pengguna (Super Admin)"| USER["Atur akun petugas dan peran"]
  OPSI -->|"Laporan"| LAP["Tampilkan rekap pesanan dan kunjungan"]
  KONTEN --> VALID["Validasi data serta simpan perubahan"]
  TIKET --> VALID
  USER --> VALID
