# ==============================================================================
# WISATA CIREBON (Batu Lawang & Gunung Bendera) — Konfigurasi Environment
# Salin file ini ke `.env` dan isi nilainya. Jangan pernah commit file `.env`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE POSTGRESQL (Wajib)
# Contoh Docker lokal: postgresql://wisata:wisata_local_password@127.0.0.1:5432/wisata_cirebon?schema=public
# Contoh Neon/Supabase: gunakan connection pooler untuk DATABASE_URL dan koneksi langsung untuk DIRECT_URL
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://wisata:wisata_local_password@127.0.0.1:5432/wisata_cirebon?schema=public"
DIRECT_URL="postgresql://wisata:wisata_local_password@127.0.0.1:5432/wisata_cirebon?schema=public"

# ------------------------------------------------------------------------------
# 2. APLIKASI & KUNCI KRIPTOGRAFI INTI (Wajib — minimal 32 karakter acak)
# Hasilkan dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"
BETTER_AUTH_SECRET="ganti_dengan_64_karakter_hex_acak_untuk_sesi_better_auth_resmi"
QR_SIGNING_SECRET="ganti_dengan_64_karakter_hex_acak_untuk_hmac_dan_cipher_tiket"
CRON_SECRET="ganti_dengan_64_karakter_hex_acak_untuk_endpoint_cron_expired"

# ------------------------------------------------------------------------------
# 3. OAUTH SOSIAL (Opsional — kosongkan bila belum dikonfigurasi; tombol otomatis disembunyikan)
# Callback Google  : {APP_URL}/api/auth/callback/google
# Callback Facebook: {APP_URL}/api/auth/callback/facebook
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 4. PENYEDIA WHATSAPP OTP & NOTIFIKASI E-TICKET (Opsional: "" | "fonnte" | "meta")
# Bila kosong, login OTP WhatsApp otomatis dinonaktifkan dengan rapi.
# ------------------------------------------------------------------------------
WA_PROVIDER=""
FONNTE_TOKEN=""
META_WA_TOKEN=""
META_WA_PHONE_ID=""

# ------------------------------------------------------------------------------
# 5. PEMBAYARAN MIDTRANS SNAP (Opsional saat dev awal; wajib untuk transaksi nyata)
# Webhook URL di portal Midtrans: {APP_URL}/api/webhooks/midtrans
# ------------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# ------------------------------------------------------------------------------
# 6. EMAIL SMTP (Opsional — untuk pengiriman e-ticket, reset sandi, & alert admin)
# ------------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Wisata Cirebon <tiket@wisatacirebon.id>"

# ------------------------------------------------------------------------------
# 7. PENYIMPANAN MEDIA & FOTO ULASAN ("local" untuk dev | "s3" untuk Cloudflare R2 / S3)
# ------------------------------------------------------------------------------
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ------------------------------------------------------------------------------
# 8. AKUN SUPER ADMIN PERTAMA (Digunakan oleh `npm run db:seed`)
# Wajib mengaktifkan 2FA TOTP saat pertama kali masuk ke dashboard.
# ------------------------------------------------------------------------------
SEED_SUPERADMIN_EMAIL="superadmin@wisatacirebon.id"
SEED_SUPERADMIN_PASSWORD="GantiPasswordKuat#2026!"
SEED_SUPERADMIN_NAME="Pengelola Utama Wisata Cirebon"
SEED_SUPERADMIN_WHATSAPP="+6281200000001"

# Kata sandi awal untuk akun petugas hasil seed (WAJIB diganti sebelum produksi)
SEED_STAFF_PASSWORD="GantiSandiPetugas#2026!"
