{
  "name": "wisata-cirebon",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi penjualan tiket wisata produksi Batu Lawang & Gunung Bendera, Desa Cupang, Kecamatan Gempol, Kabupaten Cirebon",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "icons:css": "node scripts/build-icons-css.mjs",
    "dev": "node scripts/build-icons-css.mjs && next dev",
    "build": "node scripts/build-icons-css.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "i18n:check": "node scripts/i18n-check.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "maps:build": "node scripts/build-maps.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@date-fns/tz": "1.5.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "5.9.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-table": "9.3.1",
    "better-auth": "1.7.10",
    "bootstrap-icons": "1.13.2",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "gsap": "3.15.0",
    "jsqr": "1.4.0",
    "maplibre-gl": "6.14.0",
    "motion": "14.3.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "nodemailer": "10.1.2",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "pmtiles": "4.5.0",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-hook-form": "7.90.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.8",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "lighthouse": "13.5.0",
    "postcss": "8.5.30",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.21": true,
    "unrs-resolver@1.12.2": true
  }
}
