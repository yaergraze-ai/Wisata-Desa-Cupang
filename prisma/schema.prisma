generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum Locale {
  id
  en
}

enum GateType {
  GERBANG_BATU_LAWANG
  PINTU_GUNUNG_BENDERA
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  CANCELLED
  REFUNDED
  EXPIRED
}

enum ScanResult {
  ACCEPTED
  REJECTED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RefundChannel {
  PROVIDER_API
  MANUAL
}

enum StaffOverrideMode {
  FOLLOW_SCHEDULE
  FORCE_ACTIVE
  FORCE_INACTIVE
}

enum ContactMessageStatus {
  UNREAD
  READ
  ARCHIVED
}

enum OtpPurpose {
  LOGIN
  VERIFY_WHATSAPP
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  emailVerified       Boolean   @default(false)
  image               String?
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean?  @default(false)
  role                Role      @default(MEMBER)
  locale              Locale    @default(id)
  whatsapp            String?
  whatsappVerifiedAt  DateTime?
  bio                 String?   @db.Text
  nik                 String?
  address             String?   @db.Text
  province            String?
  city                String?
  district            String?
  postalCode          String?
  emergencyContact    String?
  consentAt           DateTime?
  deletedAt           DateTime?
  twoFactorEnabled    Boolean?  @default(false)
  banned              Boolean?  @default(false)
  banReason           String?
  banExpires          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  companionProfiles   CompanionProfile[]
  sessions            Session[]
  accounts            Account[]
  twoFactors          TwoFactor[]
  orders              Order[]
  reviews             Review[]          @relation("ReviewAuthor")
  repliedReviews      Review[]          @relation("ReviewReplier")
  reviewReactions     ReviewReaction[]
  gateScans           GateScan[]
  staffProfile        StaffProfile?
  refundRequests      RefundRequest[]   @relation("RefundRequester")
  decidedRefunds      RefundRequest[]   @relation("RefundDecider")
  notifications       Notification[]
  uploadedAssets      MediaAsset[]
  auditLogs           AuditLog[]

  @@index([role])
  @@index([whatsapp])
  @@map("user")
}

model Session {
  id               String    @id @default(cuid())
  expiresAt        DateTime
  token            String    @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  ipAddress        String?
  userAgent        String?
  impersonatedBy   String?
  stepUpVerifiedAt DateTime?
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@index([secret])
  @@map("twoFactor")
}

model WhatsappOtp {
  id          String     @id @default(cuid())
  phone       String
  userId      String?
  purpose     OtpPurpose
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([phone, purpose, createdAt])
}

model Destination {
  id              String   @id @default(cuid())
  slug            String   @unique
  nameId          String
  nameEn          String
  descriptionId   String
  descriptionEn   String
  lat             Float
  lng             Float
  elevationM      Int
  openTime        String
  closeTime       String
  defaultCapacity Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dailyQuotas   DailyQuota[]
  trailPoints   TrailPoint[]
  staffProfiles StaffProfile[]
  leaveRequests LeaveRequest[]
}

model TicketProduct {
  id                   String     @id @default(cuid())
  code                 String     @unique
  nameId               String
  nameEn               String
  descriptionId        String
  descriptionEn        String
  allowedGates         GateType[]
  consumesDestinations String[]
  isActive             Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  tariffs    TicketTariff[]
  orderItems OrderItem[]
  tickets    Ticket[]
}

model TicketTariff {
  id            String        @id @default(cuid())
  productId     String
  product       TicketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  version       Int
  basePrice     Int
  parkingFee    Int
  effectiveFrom DateTime
  createdById   String?
  createdAt     DateTime      @default(now())

  orderItems OrderItem[]

  @@unique([productId, version])
  @@index([productId, effectiveFrom])
}

model DailyQuota {
  id            String      @id @default(cuid())
  date          DateTime    @db.Date
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  capacity      Int
  isCustom      Boolean     @default(false)
  updatedAt     DateTime    @updatedAt

  @@unique([date, destinationId])
  @@index([destinationId, date])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  locale          Locale      @default(id)
  visitDate       DateTime    @db.Date
  status          OrderStatus @default(PENDING)
  totalAmount     Int
  expiresAt       DateTime
  provider        String
  providerRef     String?
  snapRedirectUrl String?
  visitorName     String
  visitorWhatsapp String
  paidAt          DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items          OrderItem[]
  tickets        Ticket[]
  paymentEvents  PaymentEvent[]
  refundRequests RefundRequest[]

  @@index([visitDate, status, expiresAt])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model OrderItem {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     TicketProduct @relation(fields: [productId], references: [id])
  tariffId    String
  tariff      TicketTariff  @relation(fields: [tariffId], references: [id])
  qty         Int
  unitBase    Int
  unitParking Int
  unitTotal   Int
  subtotal    Int

  ticket Ticket?

  @@index([orderId])
  @@index([productId])
  @@index([tariffId])
}

model Ticket {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId     String        @unique
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId       String
  product         TicketProduct @relation(fields: [productId], references: [id])
  publicCode      String        @unique
  qrTokenHash     String        @unique
  qrTokenCipher   String
  visitorName     String
  visitorWhatsapp String
  visitDate       DateTime      @db.Date
  admitCount      Int
  status          TicketStatus  @default(ACTIVE)
  issuedAt        DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  gateScans GateScan[]
  review    Review?

  @@index([visitDate, status])
  @@index([orderId])
  @@index([productId])
}

model GateScan {
  id        String     @id @default(cuid())
  ticketId  String
  ticket    Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  gate      GateType
  staffId   String
  staff     User       @relation(fields: [staffId], references: [id])
  result    ScanResult
  reason    String
  scannedAt DateTime   @default(now())

  @@index([ticketId, gate])
  @@index([scannedAt])
  @@index([staffId, scannedAt])
}

model PaymentEvent {
  id             String   @id @default(cuid())
  orderId        String?
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  provider       String
  eventKey       String   @unique
  signatureValid Boolean
  payload        Json
  processedAt    DateTime @default(now())

  @@index([orderId])
}

model Review {
  id               String       @id @default(cuid())
  ticketId         String       @unique
  ticket           Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation("ReviewAuthor", fields: [userId], references: [id])
  productCode      String
  destinationSlugs String[]
  rating           Int
  comment          String
  status           ReviewStatus @default(PUBLISHED)
  managerReply     String?
  repliedAt        DateTime?
  repliedById      String?
  repliedBy        User?        @relation("ReviewReplier", fields: [repliedById], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  photos    ReviewPhoto[]
  reactions ReviewReaction[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([repliedById])
}

model ReviewReaction {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
}

model ReviewPhoto {
  id         String   @id @default(cuid())
  reviewId   String
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  storageKey String
  width      Int
  height     Int
  sizeBytes  Int
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([reviewId])
}

model RefundRequest {
  id                String         @id @default(cuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedById     String
  requestedBy       User           @relation("RefundRequester", fields: [requestedById], references: [id])
  reason            String
  amount            Int
  status            RefundStatus   @default(PENDING)
  refundChannel     RefundChannel?
  providerRefundRef String?
  decidedById       String?
  decidedBy         User?          @relation("RefundDecider", fields: [decidedById], references: [id])
  decidedAt         DateTime?
  note              String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([orderId])
  @@index([requestedById])
  @@index([decidedById])
}

model StaffProfile {
  id             String            @id @default(cuid())
  userId         String            @unique
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId  String
  destination    Destination       @relation(fields: [destinationId], references: [id])
  jobTitleId     String
  jobTitleEn     String
  publicName     String
  initials       String
  isMinor        Boolean           @default(false)
  whatsapp       String
  assignedGates  GateType[]
  weeklySchedule Json
  overrideMode   StaffOverrideMode @default(FOLLOW_SCHEDULE)
  overrideUntil  DateTime?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  leaveRequests LeaveRequest[]

  @@index([destinationId, isActive])
}

model LeaveRequest {
  id             String       @id @default(cuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  destinationId  String
  destination    Destination  @relation(fields: [destinationId], references: [id])
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([destinationId, createdAt])
  @@index([staffProfileId])
}

model Notification {
  id              String    @id @default(cuid())
  recipientUserId String?
  recipientUser   User?     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientRole   Role?
  type            String
  titleKey        String
  bodyKey         String
  params          Json
  linkPath        String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([recipientRole, readAt, createdAt])
  @@index([recipientUserId, readAt, createdAt])
}

model TrailPoint {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  order         Int
  code          String
  nameId        String
  nameEn        String
  noteId        String
  noteEn        String
  lat           Float
  lng           Float
  elevationM    Int
  distFromPrevM Int
  minsFromPrev  Int

  @@unique([destinationId, order])
  @@unique([destinationId, code])
}

model MediaAsset {
  id           String   @id @default(cuid())
  storageKey   String   @unique
  mimeType     String
  width        Int
  height       Int
  sizeBytes    Int
  altId        String
  altEn        String
  isDefault    Boolean  @default(false)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  slots MediaSlot[]

  @@index([uploadedById])
}

model MediaSlot {
  id          String     @id @default(cuid())
  slot        String     @unique
  assetId     String
  asset       MediaAsset @relation(fields: [assetId], references: [id])
  labelId     String
  labelEn     String
  updatedAt   DateTime   @updatedAt
  updatedById String?

  @@index([assetId])
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  whatsapp  String
  message   String
  status    ContactMessageStatus @default(UNREAD)
  ipHash    String?
  createdAt DateTime             @default(now())
  readAt    DateTime?

  @@index([status, createdAt])
}

model SiteSetting {
  key           String   @id
  valueType     String
  value         String
  descriptionId String
  descriptionEn String
  updatedAt     DateTime @updatedAt
  updatedById   String?
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole String?
  action    String
  entity    String
  entityId  String?
  ip        String?
  userAgent String?
  metadata  Json
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model RateLimit {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime

  @@unique([key, windowStart])
  @@index([expiresAt])
}

model CompanionProfile {
  id             String   @id @default(cuid())
  userId         String
  name           String
  identityNumber String?
  phone          String?
  relation       String?
  age            Int?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SocialLinkRequest {
  id           String   @id @default(cuid())
  staffId      String
  staffName    String
  platform     String   // "TIKTOK" | "INSTAGRAM"
  proposedUrl  String
  note         String?
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}
