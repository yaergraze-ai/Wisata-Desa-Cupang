# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output
/.next/
/out/
/build

# Environment & secrets (NEVER commit)
.env
.env.*
!.env.example

# Reference prototype files (kept locally on disk per AGENTS.md §8.5, excluded from git & deploy per §10.12)
/referensi/
/scratch/

# Local uploaded media (dev local storage driver)
/public/uploads/*
!/public/uploads/.gitkeep
/storage/

# Generated offline map tiles if large / built via npm run maps:build
# (manifest and default style/geojson stay tracked; large binary archives built on demand)

# Testing & coverage
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# Debug & OS
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
*.pem
*.tsbuildinfo
next-env.d.ts
